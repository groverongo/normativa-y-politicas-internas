# Copia este archivo como .env y completa los valores.

# ---------- App ----------
APP_NAME=NttBanca API
DEBUG=false

# ---------- PostgreSQL (AWS RDS) ----------
# Endpoint de la instancia RDS, p. ej. mi-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# RDS exige SSL: deja require
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
# Aplica las migraciones pendientes de migrations/ al arrancar
DB_AUTO_CREATE_TABLES=true

# ---------- AWS / S3 ----------
AWS_REGION=us-east-1
# Si dejas las keys vacías, boto3 usa ~/.aws/credentials o el rol IAM (EC2/ECS/Lambda)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo si usas credenciales temporales (STS / SSO)
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=
# Carpeta dentro del bucket donde se guardan los archivos
S3_KEY_PREFIX=uploads
S3_PRESIGNED_URL_EXPIRATION=3600

# ---------- Orquestador ----------
# Pausa de cada agente stub (ms) para que la demo muestre el avance; 0 = sin pausa
AGENT_STUB_DELAY_MS=1000

# ---------- Pipeline de ingesta (Classifier/Extraction/Validation/Graph-Update) ----------
# mock = heurística determinista, sin API key (default). O: anthropic | openai | gemini
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
OPENAI_BASE_URL=
# ANTHROPIC_API_KEY= / OPENAI_API_KEY= / GEMINI_API_KEY= -- solo si LLM_PROVIDER no es mock
MAX_RECLASSIFY_ATTEMPTS=2
MAX_IMPACT_DOCS=5
MAX_CASCADE_DEPTH=1
