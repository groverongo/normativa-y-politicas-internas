# Cargar con: set -a; source .env; set +a

# Postgres (pgvector + tsvector/GIN) y S3 (texto crudo), mismas variables que
# modules/ingesta y modules/nttbanca-n -- ver la migración
# ../nttbanca-n/migrations/0009_nttdatabanca_rag_support.sql.
# REGISTRY_BACKEND=file (default) sigue leyendo registry.json/corpus/ sin
# ningún servicio externo (incluido `ingest -dry`); REGISTRY_BACKEND=postgres
# lee/escribe el registro en la tabla compartida `documents`.
REGISTRY_BACKEND=file
DB_HOST=
DB_PORT=5432
DB_NAME=nttbanca
DB_USER=nttbanca
DB_PASSWORD=
DB_SSLMODE=
DB_CONNECT_TIMEOUT=10

AWS_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_KEY_PREFIX=nttdatabanca

# Proveedores de embeddings y rerank: voyage | jina
EMB_PROVIDER=voyage
RERANK_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-2.5

JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v5-text-small
JINA_RERANK_MODEL=jina-reranker-v3.5
EMBED_DIM=1024   # solo Jina

# Cualquier API compatible con OpenAI. Default: endpoint OpenAI-compatible de Gemini.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_REASONING_EFFORT=low   # low | medium | high (Gemini 3.x no admite none)
LLM_PRICE_IN=0.75          # USD por millón de tokens (para el log de costo)
LLM_PRICE_OUT=3.75

REGISTRY_PATH=registry.json
ADDR=:8080
CORS_ORIGIN=*
