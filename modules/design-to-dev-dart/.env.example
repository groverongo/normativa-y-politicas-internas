# Copy to .env.local (or .env) and adjust as needed. Nothing here is required
# to run the app with demo fixtures.

# "backend" reads /biblioteca from modules/ingesta's API instead of the demo
# fixtures. Exposed to the browser bundle (VITE_ prefix) -- it only selects a
# provider, it is not a secret.
VITE_SERVICES_MODE=demo

# Server-only: base URL of modules/ingesta's FastAPI app (api.py). Read with
# process.env inside src/server/ingesta-client.ts, never import.meta.env, so
# it is never sent to the browser. Matches the port modules/ingesta's
# docker-compose service publishes (see ../../docker-compose.yml).
INGESTA_API_URL=http://localhost:8000

# Server-only: base URL of modules/nttdatabanca's RAG API (POST /ask), read by
# the Consultor normativo page ("/"). Same process.env-only convention as
# INGESTA_API_URL. Matches the port modules/nttdatabanca's docker-compose
# service publishes.
NTTDATABANCA_API_URL=http://localhost:8002
