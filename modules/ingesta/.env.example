# Copy this file to .env and fill in what you need. Everything has a safe
# default (mock provider, no API key) so the smoke test and sample run work
# out of the box with no edits.

# mock|anthropic|openai|gemini (default: mock -- no API key needed, deterministic heuristics)
LLM_PROVIDER=mock
# required for real providers, e.g. claude-opus-4-20250514, gpt-4o-mini, gemini-1.5-pro
LLM_MODEL=
# sampling temperature passed to the real provider
LLM_TEMPERATURE=0.0
# max output tokens passed to the real provider
LLM_MAX_TOKENS=4096
# optional: point the OpenAI client at an OpenAI-compatible endpoint (Ollama, Groq, vLLM...)
OPENAI_BASE_URL=

# loop 1 bound: extra validation -> classifier reclassification passes (0 = classify once, no retries)
MAX_RECLASSIFY_ATTEMPTS=2
# loop 2 bound: max fan-out of case-9 "redefined term" impact reassessment per document
MAX_IMPACT_DOCS=5
# loop 2 bound: cascade depth from a redefinition; only 1 is supported/implemented
MAX_CASCADE_DEPTH=1
# directory where each CLI run writes runs/<run_id>/{interaction_log.jsonl,summary.json,storage_snapshot.json}
RUNS_DIR=runs

# memory|postgres (default: memory -- dict-backed, no setup needed, lost on exit)
STORAGE_BACKEND=memory

# Postgres (metadata graph, shared with modules/nttbanca-n) -- required when
# STORAGE_BACKEND=postgres. Run `make migrate` from the repo root once against
# this database before using this backend -- this module no longer
# auto-creates its schema (see ../nttbanca-n/migrations/README.md).
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=                      # read directly from the environment by storage.S3DbStorage, not by Settings
# DB_SSLMODE=require                # e.g. require for managed Postgres (RDS, etc.)
# DB_CONNECT_TIMEOUT=10

# S3 (raw document text) -- required when STORAGE_BACKEND=postgres.
# AWS_REGION=
# S3_BUCKET_NAME=
# S3_KEY_PREFIX=                    # optional: key prefix for raw document objects in the bucket (e.g. uploads)
# S3_ENDPOINT_URL=                  # optional: point at an S3-compatible endpoint (MinIO, LocalStack, R2...)
# S3_PRESIGNED_URL_EXPIRATION=3600  # seconds; reserved for a future presigned-URL endpoint, not yet used

# API keys -- only the one matching LLM_PROVIDER is required, and only when
# LLM_PROVIDER is a real provider (not "mock").
# ANTHROPIC_API_KEY=               # required when LLM_PROVIDER=anthropic
# OPENAI_API_KEY=                  # required when LLM_PROVIDER=openai (or any OpenAI-compatible endpoint that needs a key)
# GEMINI_API_KEY=                  # required when LLM_PROVIDER=gemini (fallback env var: GOOGLE_API_KEY)

# AWS credentials -- read directly by boto3's default credential chain, not by
# Settings. Only needed when STORAGE_BACKEND=postgres and you're not using an
# attached IAM role / shared credentials file.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
